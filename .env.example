# Django Configuration
DJANGO_SECRET_KEY='your-secret-key-here-generate-a-new-one'
DEBUG=False

# OAuth2 Application Credentials
APP_CLIENT_ID='your-client-id-here'
APP_CLIENT_SECRET='your-client-secret-here'
APP2_CLIENT_ID='your-second-client-id-here'
APP2_CLIENT_SECRET='your-second-client-secret-here'

# OIDC Configuration
OIDC_RSA_PRIVATE_KEY_PATH=/path/to/your/private/key.pem

# Database Configuration (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/authy_oidc_db

# CORS Settings
CORS_ALLOWED_ORIGINS=https://app1.example.com,https://app2.example.com

# Email Configuration (for password resets, notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Sentry Configuration (for error tracking)
SENTRY_DSN=your-sentry-dsn-here
